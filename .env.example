# Spectrum (iMessage provider)
SPECTRUM_PROJECT_ID=your-project-id
SPECTRUM_PROJECT_SECRET=your-project-secret
SPECTRUM_WEBHOOK_SECRET=your-webhook-secret

# Main model provider: "anthropic" (Claude via OAuth) or "xiaomi-token-plan-sgp" (MiMo)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-8
LLM_CLASSIFIER_MODEL=claude-haiku-4-5
# Anthropic uses OAuth credentials from the pi harness (~/.pi/agent/auth.json).
# Override the path with PI_AUTH_PATH if needed.

# MiMo / Xiaomi endpoint. Main provider when LLM_PROVIDER=xiaomi-token-plan-sgp,
# and always the multimodal sidecar that transcribes audio/video for Claude.
LLM_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
LLM_API_KEY=your-api-key
MEDIA_MODEL=mimo-v2.5

# Optional
# THREAD_DETECTION=1            # smart thread/session detection (0 to disable)
# THREAD_WARM_WINDOW_MS=1200000 # cache window before re-classifying a thread
WORKING_DIRECTORY=/path/to/your/code
LOG_DIR=./logs
DEBUG=1
